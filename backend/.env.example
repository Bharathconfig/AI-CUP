# Export these variables in your shell/container; no automatic dotenv loading.
# memory is ephemeral/single-process; firestore shares state across instances.
STATE_BACKEND=memory
# true refuses startup without a nonempty token. A configured token protects
# POST /api/disruptions and POST /api/reset in every mode; reads remain public.
REQUIRE_API_TOKEN=false
API_TOKEN=
# Legacy BACKEND_STORE, BACKEND_PRODUCTION, BACKEND_API_TOKEN are accepted
# only when the corresponding canonical variable above is not set.
BACKEND_CORS_ORIGINS=http://localhost:5173,http://localhost:3000
BACKEND_AI_TIMEOUT_SECONDS=5
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GOOGLE_GENAI_USE_VERTEXAI=false
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
# Firestore and Vertex require Application Default Credentials; memory and the
# deterministic agent require none. API-key Gemini only needs GEMINI_API_KEY.
FIRESTORE_COLLECTION=microgrid
FIRESTORE_DOCUMENT=simulation
# Optional Cloud integrations; configure only services you have provisioned.
BIGQUERY_TABLE=
GCS_BUCKET=
PUBSUB_TOPIC=
EARTH_ENGINE_PROJECT=
# Container listens on Cloud Run's PORT, defaulting to 8000 locally.
PORT=8000
